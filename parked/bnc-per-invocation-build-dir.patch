From dba84e7131e870319240b04df644541121578aeb Mon Sep 17 00:00:00 2001
From: Viet-Trung Luu <viettrungluu@gmail.com>
Date: Tue, 1 Sep 2026 21:58:23 -0700
Subject: [PATCH] bnc: isolate build intermediates per-invocation to fix
 concurrent-build collisions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

PARKED — does NOT build under the current BUILDER (bnc-0.0.14); depends on
os.MkdirTemp being present in the BUILDER's frozen stdlib bundle. cmd/bnc's
stdlib deps resolve from the frozen bundle at gen1-build time, so this must wait
for a BUILDER cut that includes os.MkdirTemp. Do NOT land until then.

Fixes the concurrent-native-compile collision: with no --build-dir, every module
wrote intermediates to the fixed, process-independent /tmp/binate_<base>_<module>
path (<base> = shortName(-o or input), so even different-directory builds of a
same-basename target shared it). A linking build removes those objects after the
link, so two concurrent builds clobbered each other -> "clang: no such file
.../tmp/binate_<base>_*.o -> link failed" (reproduced: 6/9 concurrent bnc builds
failed).

- outPrefixFor drops the shared /tmp fallback: with no build dir it returns ""
  (current directory), used only by the deliverable-object modes.
- effectiveBuildDir: a LINKING/ARCHIVING build (whole-program, --library, --test)
  with no --build-dir now creates a fresh unique dir via os.MkdirTemp and removes
  it after the objects are linked/archived and deleted, so concurrent builds get
  disjoint intermediate dirs.
- DELIVERABLE-object modes (-c, --pkg) emit their object as output, so with no
  --build-dir they write to the current directory (findable), not a temp dir.
- args.bn / compile_test.bn updated for the new behavior.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01A5AwPXv3TATrAoBE9jBgua
---
 cmd/bnc/args.bn         |  9 ++++----
 cmd/bnc/compile.bn      | 51 ++++++++++++++++++++++++++++++-----------
 cmd/bnc/compile_test.bn | 31 ++++++++-----------------
 cmd/bnc/library.bn      | 14 +++++++----
 cmd/bnc/main.bn         | 23 +++++++++++--------
 cmd/bnc/test.bn         | 28 +++++++++++-----------
 6 files changed, 90 insertions(+), 66 deletions(-)

diff --git a/cmd/bnc/args.bn b/cmd/bnc/args.bn
index a6a18d6be..bfe65ded1 100644
--- a/cmd/bnc/args.bn
+++ b/cmd/bnc/args.bn
@@ -40,10 +40,11 @@ type CLIArgs struct {
 	Backend  @[]char // "" = default (LLVM); "native" = pkg/binate/native (aarch64 only for now)
 	KeepObjs bool // --keep-objs: don't delete intermediate .o files (debugging aid)
 	BuildDir @[]char // --build-dir <dir>: write intermediate .ll/.o (and the
-	// default --test binary) under <dir>/ instead of the
-	// shared /tmp/binate_* path. The directory must exist;
-	// bnc does not create it. Lets concurrent test runners
-	// avoid clobbering each other's intermediates.
+	// default --test binary) under <dir>/.  The directory must
+	// exist; bnc does not create it.  When unset, a linking build
+	// creates its own unique temp dir for intermediates (so
+	// concurrent builds never collide) and a deliverable-object
+	// build (-c / --pkg / --library) writes to the current dir.
 	BniPaths @[]@[]char // -I / --interface-path: append-and-split (':') list
 	// of dirs searched for `<dir>/<path>.bni` interface
 	// files.  Cc-style — repeatable, colon-separated.
diff --git a/cmd/bnc/compile.bn b/cmd/bnc/compile.bn
index c05207a8f..2c691b452 100644
--- a/cmd/bnc/compile.bn
+++ b/cmd/bnc/compile.bn
@@ -148,29 +148,52 @@ func compileSinglePkg(cli CLIArgs) {
 	}
 
 	var pkgName @[]char = buf.CopyStr(shortName(pkgPath))
-	var base @[]char = pkgName
-	if len(cli.Output) > 0 {
-		base = buf.CopyStr(shortName(cli.Output))
-	}
-	var oPrefix @[]char = outPrefixFor(cli.BuildDir, base)
+	// A single-package build emits the object as its deliverable; with no
+	// --build-dir it lands in the current directory (findable), NOT a shared
+	// /tmp path that concurrent builds would clobber.
+	var oPrefix @[]char = outPrefixFor(cli.BuildDir)
 	// Honor --backend native for a single-package build too (clang for linking
 	// only; here there is no link — the caller assembles/links the .o).
 	var oFile @[]char = compileModuleVia(mod, oPrefix, pkgName, streq(cli.Backend, "native"))
 	fmt.Println(oFile)
 }
 
-// outPrefixFor returns the prefix string that compileLL /
-// compileModuleVia prepend to the per-module name + extension.
-// When --build-dir is set, intermediates land at "<dir>/<name>.<ext>"
-// (callers must ensure <dir> exists). Otherwise they land at
-// "/tmp/binate_<base>_<name>.<ext>" — the historical layout that
-// shares /tmp across concurrent runs.
-func outPrefixFor(buildDir *[]readonly char, base *[]readonly char) @[]char {
+// outPrefixFor returns the prefix that compileLL / compileModuleVia prepend to
+// each module's "<name>.<ext>".  With a build dir it is "<dir>/", so files land
+// there (callers must ensure <dir> exists).  Without one it is empty, so files
+// land in the current directory — used only by the deliverable-object modes
+// (-c, --pkg, --library with neither -o nor --build-dir), where the object IS
+// the output and must be findable.  The linking/archiving modes never reach the
+// empty case: they default the build dir to a fresh unique temp dir (see
+// effectiveBuildDir) so concurrent builds never collide on shared intermediates.
+func outPrefixFor(buildDir *[]readonly char) @[]char {
 	if len(buildDir) > 0 {
 		return buf.Concat(buildDir, "/")
 	}
-	return buf.Concat(
-			buf.Concat("/tmp/binate_", base), "_")
+	var empty @[]char
+	return empty
+}
+
+// effectiveBuildDir picks the directory that a LINKING / ARCHIVING build writes
+// its throwaway intermediate objects into, and reports whether this call created
+// it (so the caller removes it once the objects are consumed and deleted).  An
+// explicit --build-dir is used as-is and never removed.  Otherwise a fresh
+// unique directory is created with os.MkdirTemp: two concurrent builds — even of
+// the same target to the same output — get disjoint intermediate dirs, so one
+// build's post-link object cleanup can never delete an object out from under a
+// concurrent build (which surfaced as "clang: no such file .../tmp/binate_*.o ->
+// link failed").  Deliverable-object modes (-c / --pkg / --library) must NOT use
+// this — their objects are outputs, not throwaway intermediates.
+func effectiveBuildDir(cli CLIArgs) (@[]char, bool) {
+	if len(cli.BuildDir) > 0 {
+		return buf.CopyStr(cli.BuildDir), false
+	}
+	td, err := os.MkdirTemp("/tmp", "binate_")
+	if present(err) {
+		fmt.Print("error: could not create a temporary build directory\n")
+		os.Exit(1)
+	}
+	return td, true
 }
 
 // compileLL writes the LLVM IR to "<prefix><name>.ll" and compiles it
diff --git a/cmd/bnc/compile_test.bn b/cmd/bnc/compile_test.bn
index a0511a974..685a68e90 100644
--- a/cmd/bnc/compile_test.bn
+++ b/cmd/bnc/compile_test.bn
@@ -4,32 +4,21 @@ import "pkg/builtins/testing"
 
 // Tests for compile.bn pure functions.
 
-// outPrefixFor: when --build-dir is empty, fall back to the legacy
-// shared /tmp/binate_<base>_ prefix. The trailing "_" is the
-// separator that compileLL / compileModuleVia use to glue on
-// "<modname>.<ext>" — must be present.
-func TestOutPrefixForLegacy() testing.TestResult {
+// outPrefixFor: with no --build-dir the prefix is empty, so a deliverable-object
+// mode's files land in the current directory (findable), NOT a shared /tmp path.
+// The linking modes never reach this case — they default the build dir to a
+// unique temp dir first (effectiveBuildDir).
+func TestOutPrefixForNoBuildDir() testing.TestResult {
 	var noDir *[]readonly char
-	var p @[]char = outPrefixFor(noDir, "test")
-	if !seq(p, "/tmp/binate_test_") { return fail("legacy prefix wrong") }
+	var p @[]char = outPrefixFor(noDir)
+	if len(p) != 0 { return fail("no-build-dir prefix must be empty (current dir)") }
 	return ""
 }
 
-// With --build-dir <dir>, the prefix becomes "<dir>/" — the trailing
-// "/" is the path separator. The base argument is ignored in this
-// mode (the caller-chosen dir already isolates the run).
+// With --build-dir <dir>, the prefix becomes "<dir>/" — the trailing "/" is the
+// path separator that compileLL / compileModuleVia glue "<modname>.<ext>" onto.
 func TestOutPrefixForBuildDir() testing.TestResult {
-	var p @[]char = outPrefixFor("/tmp/work", "test")
+	var p @[]char = outPrefixFor("/tmp/work")
 	if !seq(p, "/tmp/work/") { return fail("build-dir prefix wrong") }
 	return ""
 }
-
-// Build-dir takes precedence even when base would otherwise be set,
-// and base is genuinely ignored (no leakage into the prefix).
-func TestOutPrefixForBuildDirIgnoresBase() testing.TestResult {
-	var p @[]char = outPrefixFor("/scratch", "compileMain")
-	if !seq(p, "/scratch/") {
-		return fail("build-dir prefix should ignore base")
-	}
-	return ""
-}
diff --git a/cmd/bnc/library.bn b/cmd/bnc/library.bn
index 26c411374..b162ae2e9 100644
--- a/cmd/bnc/library.bn
+++ b/cmd/bnc/library.bn
@@ -63,11 +63,14 @@ func compileLibrary(cli CLIArgs) {
 	ensureRuntimeDepsLoaded(ldr)
 	var checker @types.Checker = typecheckPackages(ldr)
 
-	var base @[]char = buf.CopyStr(shortName(facadePath))
-	if len(cli.Output) > 0 {
-		base = buf.CopyStr(shortName(cli.Output))
-	}
-	var outPrefix @[]char = outPrefixFor(cli.BuildDir, base)
+	// The per-package objects are throwaway intermediates consumed by `ar`; the
+	// deliverable is the archive (aPath, below).  Isolate the objects in a fresh
+	// unique temp dir when no --build-dir was given, so concurrent library builds
+	// never collide on shared /tmp objects; remove it after archiving.
+	var buildDir @[]char
+	var createdBuildDir bool
+	buildDir, createdBuildDir = effectiveBuildDir(cli)
+	var outPrefix @[]char = outPrefixFor(buildDir)
 
 	// Emit one object per closure package, tracking which ones have a
 	// `<pkg>.__init` (so the dispatcher lists them in dependency order).  The
@@ -141,6 +144,7 @@ func compileLibrary(cli CLIArgs) {
 		for i := 0; i < len(oFiles); i++ {
 			remove(oFiles[i])
 		}
+		if createdBuildDir { remove(buildDir) } // rmdir the now-empty temp dir
 	}
 	fmt.Println(aPath)
 }
diff --git a/cmd/bnc/main.bn b/cmd/bnc/main.bn
index 3fc1b0531..a709c0b64 100644
--- a/cmd/bnc/main.bn
+++ b/cmd/bnc/main.bn
@@ -274,15 +274,18 @@ func main() {
 	// consult per-expression resolved types via Checker.ExprType(id).
 	var checker @types.Checker = typecheckAll(ldr, file)
 
-	// Output prefix for intermediate files. With --build-dir <d>,
-	// files land at "<d>/<modname>.<ext>"; otherwise the legacy
-	// "/tmp/binate_<base>_<modname>.<ext>" layout (where <base> is
-	// derived from -o or the input filename) is used.
-	var base @[]char = buf.CopyStr(shortName(stripExt(filename)))
-	if len(output) > 0 {
-		base = buf.CopyStr(shortName(output))
-	}
-	var outPrefix @[]char = outPrefixFor(cli.BuildDir, base)
+	// A linking build's per-module objects are throwaway intermediates: isolate
+	// them in a fresh unique directory (unless --build-dir was given) so two
+	// concurrent builds never write — or, worse, delete after linking — the same
+	// shared /tmp objects.  -c stops after emitting deliverable objects (below),
+	// which must stay findable, so it keeps the given build dir (empty => current
+	// directory) and never creates a temp one.  createdBuildDir drives the
+	// after-link removal of the temp dir.
+	var createdBuildDir bool = false
+	if !cli.CompileOnly {
+		cli.BuildDir, createdBuildDir = effectiveBuildDir(cli)
+	}
+	var outPrefix @[]char = outPrefixFor(cli.BuildDir)
 	var useNative bool = streq(cli.Backend, "native")
 
 	// Compile dependency packages.  Track which ones emit
@@ -387,6 +390,7 @@ func main() {
 	if streq(cli.Linker, "bnld") {
 		var ok bool = linkWithBnld(cli, oFiles, output)
 		for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
+		if createdBuildDir { remove(cli.BuildDir) } // rmdir the now-empty temp dir
 		if !ok { os.Exit(1) }
 		debug.Log("compilation complete")
 		return
@@ -424,6 +428,7 @@ func main() {
 	status, err := process.Run("clang", &process.Options{SearchPath: true, Args: clangArgs})
 	for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
 	for i := 0; i < len(bnasObjs); i++ { remove(bnasObjs[i]) }
+	if createdBuildDir { remove(cli.BuildDir) } // rmdir the now-empty temp dir
 	if present(err) || !status.Success() {
 		fmt.Println("error: link failed")
 		os.Exit(1)
diff --git a/cmd/bnc/test.bn b/cmd/bnc/test.bn
index 5a135cfbd..c13d7bd10 100644
--- a/cmd/bnc/test.bn
+++ b/cmd/bnc/test.bn
@@ -142,8 +142,16 @@ func runTestMode(cli CLIArgs) {
 		os.Exit(1)
 	}
 
-	// Intermediate prefix: "<build-dir>/" or "/tmp/binate_test_".
-	var outPrefix @[]char = outPrefixFor(cli.BuildDir, "test")
+	// The objects AND the linked test binary live in the build dir.  With no
+	// --build-dir, give this run its own unique dir (os.MkdirTemp via
+	// effectiveBuildDir) so concurrent test builds never collide on shared /tmp
+	// objects or a shared test-binary path.  The dir is not removed here: the
+	// test binary lives in it (the harness passes --build-dir and cleans it up; a
+	// manual run finds the binary at the printed path).
+	if len(cli.BuildDir) == 0 {
+		cli.BuildDir, _ = effectiveBuildDir(cli)
+	}
+	var outPrefix @[]char = outPrefixFor(cli.BuildDir)
 	var useNative bool = streq(cli.Backend, "native")
 
 	// Compile dependency packages. Per-module backend dispatch:
@@ -228,17 +236,11 @@ func runTestMode(cli CLIArgs) {
 	oFiles = appendRawCharSlice(oFiles, mainO)
 	debug.Log("phase: link")
 
-	// Link. With --build-dir, the binary defaults to <build-dir>/test_bin
-	// (so it's cleaned up alongside the .o files); otherwise the legacy
-	// /tmp/binate_test_bin path. -o on the command line still wins —
-	// but the test harness doesn't pass -o, so this default is what
-	// matters for concurrent runs.
-	var output @[]char
-	if len(cli.BuildDir) > 0 {
-		output = buf.Concat(cli.BuildDir, "/test_bin")
-	} else {
-		output = "/tmp/binate_test_bin"
-	}
+	// The test binary lands at "<build-dir>/test_bin" beside its objects.
+	// cli.BuildDir is always set by now — an explicit --build-dir, or the unique
+	// temp dir created above — so concurrent test builds never share a binary
+	// path.  (The harness passes --build-dir and cleans it up afterward.)
+	var output @[]char = buf.Concat(cli.BuildDir, "/test_bin")
 	var clangArgs @[]@[]char
 	clangArgs = appendRawCharSlice(clangArgs, "-w")
 	if debugInfo { clangArgs = appendRawCharSlice(clangArgs, "-g") }
